{
  "id": "com.stark.jarvis.os",
  "name": "J.A.R.V.I.S. Personal Assistant",
  "short_name": "JARVIS",
  "description": "Personal assistant for voice commands, local tasks and notes, research, and external app handoff.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "fullscreen",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#030710",
  "theme_color": "#00e5ff",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./favicon.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
